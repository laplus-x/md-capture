{
  "name": "md-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt --write",
    "typecheck": "tsc --noEmit -p .wxt/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "verify": "npm run check && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/chrome": "^0.0.254",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "wxt": "^0.19.0"
  }
}
